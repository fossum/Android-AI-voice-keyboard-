<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_description"
            android:textSize="14sp"
            android:textColor="@color/colorHint"
            android:layout_marginBottom="24dp" />

        <!-- Step 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step1_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_status_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/colorHint"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_enable_keyboard"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_enable_keyboard"
            android:layout_marginBottom="24dp" />

        <!-- Step 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step2_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_select_keyboard"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_select_keyboard"
            android:layout_marginBottom="24dp" />

        <!-- Step 3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/step3_label"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_status_signed_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/colorHint"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_sign_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_sign_in"
            android:layout_marginBottom="32dp" />

        <!-- Settings shortcut -->
        <Button
            android:id="@+id/btn_settings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_settings" />

    </LinearLayout>

</ScrollView>
