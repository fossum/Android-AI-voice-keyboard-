<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration that allows HTTPS traffic only.
    The Gemini API is accessed over HTTPS (generativelanguage.googleapis.com).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
